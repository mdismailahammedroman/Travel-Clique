datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  password        String
  name            String
  role            Role          @default(USER)
  profile         Profile?
  travelPlans     TravelPlan[]
  groupsCreated   TravelGroup[] @relation("GroupCreator")
  groupMembers    GroupMember[]
  reviewsGiven    Review[]      @relation("Reviewer")
  reviewsReceived Review[]      @relation("Reviewed")
  subscriptions   Subscription[]
  payments        Payment[]
  matchesSent     Match[]       @relation("MatchSender")
  matchesReceived Match[]       @relation("MatchReceiver")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}


// =============================
// PROFILE
// =============================
model Profile {
  id               String     @id @default(cuid())
  user             User       @relation(fields: [userId], references: [id])
  userId           String     @unique
  fullName         String
  profileImage     String?
  bio              String?
  travelInterests  TravelInterest[]
  visitedCountries VisitedCountry[]
  currentLocation  String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model TravelInterest {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  interest  String
}

model VisitedCountry {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  country   String
}

// =============================
// ENUMS
// =============================
enum Role {
  USER
  MODERATOR
  ADMIN
}

enum TravelType {
  SOLO
  FAMILY
  FRIENDS
}

enum MatchStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SubscriptionType {
  MONTHLY
  YEARLY
}
// =============================
// SUBSCRIPTION (must pay to join group)
// =============================
model Subscription {
  id            String        @id @default(cuid())
  user          User          @relation(fields: [userId], references: [id])
  userId        String
  type          SubscriptionType
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean        @default(true)
  verifiedBadge Boolean        @default(false)
  paymentId     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// =============================
// PAYMENTS + INVOICE
// =============================
model Payment {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  amount      Float
  currency    String     @default("USD")
  status      PaymentStatus
  invoiceUrl  String?    // downloadable invoice link
  subscriptionId String?
  createdAt   DateTime  @default(now())
}
// =============================
// REVIEWS
// =============================
model Review {
  id           String   @id @default(cuid())
  reviewer     User     @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewerId   String
  reviewed     User     @relation("Reviewed", fields: [reviewedId], references: [id])
  reviewedId   String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
// =============================
// TRAVEL PLAN
// =============================
model TravelPlan {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  destination  String
  startDate    DateTime
  endDate      DateTime
  budgetMin    Float?
  budgetMax    Float?
  travelType   TravelType
  description  String?
  visibility   Boolean       @default(true)

  // FIXED RELATION
  group        TravelGroup?  @relation("PlanToGroup")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// =============================
// TRAVEL GROUP (Main Feature)
// =============================
model TravelGroup {
  id           String        @id @default(cuid())
  name         String
  creator      User          @relation("GroupCreator", fields: [creatorId], references: [id])
  creatorId    String
  destination  String
  startDate    DateTime
  endDate      DateTime
  isPaidGroup  Boolean       @default(true)
  members      GroupMember[]

  // FIXED RELATION (one-to-one → travelPlanId must be unique)
  travelPlan   TravelPlan?   @relation("PlanToGroup", fields: [travelPlanId], references: [id])
  travelPlanId String?       @unique

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// =============================
// GROUP MEMBERS (Join after payment)
// =============================
model GroupMember {
  id        String      @id @default(cuid())
  group     TravelGroup @relation(fields: [groupId], references: [id])
  groupId   String
  user      User        @relation(fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime    @default(now())
  isActive  Boolean     @default(true)
}
// =============================
// MATCHING PARTNER SYSTEM
// =============================
model Match {
  id            String   @id @default(cuid())
  sender        User     @relation("MatchSender", fields: [senderId], references: [id])
  senderId      String
  receiver      User     @relation("MatchReceiver", fields: [receiverId], references: [id])
  receiverId    String
  status        MatchStatus @default(PENDING) // ACCEPTED / DECLINED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

